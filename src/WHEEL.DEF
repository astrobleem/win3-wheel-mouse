LIBRARY MOUSE
DESCRIPTION 'Windows XT universal wheel candidate'
EXETYPE WINDOWS
CODE PRELOAD FIXED
DATA PRELOAD FIXED SINGLE
HEAPSIZE 0
STACKSIZE 0
EXPORTS
 INQUIRE=Inquire @1
 ENABLE=Enable @2
 DISABLE=Disable @3
 MOUSEGETINTVECT=MouseGetIntVect @4
 WEP @5
 WHEELAPIVERSION=WheelApiVersion @10
 WHEELREADDELTA=WheelReadDelta @11
 WHEELLOSTPACKETS=WheelLostPackets @12
 WHEELREADDELTAAGE=WheelReadDeltaAge @13
 WHEELSTATUS=WheelStatus @14
